FROM node:24.13.0-slim AS build
WORKDIR /app

# Copy package files and .npmrc template
COPY package.json package-lock.json .npmrc.template ./
RUN mv .npmrc.template .npmrc

# Setup authentication via build arg
ARG GITHUB_TOKEN
RUN echo "//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}" >> .npmrc

# Install dependencies
RUN npm ci

# Remove .npmrc for security
RUN rm .npmrc

# Copy source
COPY . .

# Build frontend and server
RUN BASE_URL="" npx vite build --mode production
RUN npm run build:server

# Production stage
FROM node:24.13.0-slim
WORKDIR /app

# Copy built artifacts
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

EXPOSE 5183

# Run the server
CMD ["npm", "start"]
